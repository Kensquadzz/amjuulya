# ==========================================================================
# AMJUULYA — environment variables (example only, NEVER put real secrets here)
# Local: copy to .env.local and fill in.  Vercel: Project → Settings → Environment Variables.
# All keys are read server-side only (api/*). Nothing here is sent to the browser.
# ==========================================================================

# ---------- Language model (required for /learn.html) ----------
# Shared with the existing Messenger bot (api/webhook.js).
ANTHROPIC_API_KEY=
# Optional: a separate key just for the learning assistant (takes priority over ANTHROPIC_API_KEY
# for /api/learn/* only; the Messenger bot keeps using ANTHROPIC_API_KEY)
# LEARN_ANTHROPIC_API_KEY=
# Optional overrides for the learning assistant only (defaults shown)
# LEARN_ANTHROPIC_MODEL=claude-opus-5-5
# LEARN_ANTHROPIC_EFFORT=low
# LEARN_LLM_TIMEOUT_MS=25000

# ---------- Speech-to-text (optional; without it the browser's own recognition is used if available) ----------
# Provider is auto-selected from the keys below, or force one:
#   STT_PROVIDER=elevenlabs|openai|none   (per language: STT_PROVIDER_MN / STT_PROVIDER_EN)
ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1
OPENAI_API_KEY=
# OPENAI_STT_MODEL=gpt-4o-transcribe
# LEARN_STT_TIMEOUT_MS=20000

# ---------- Text-to-speech (optional; without it the play button uses a device voice or is disabled) ----------
#   TTS_PROVIDER=azure|elevenlabs|openai|none   (per language: TTS_PROVIDER_MN / TTS_PROVIDER_EN)
# Azure Neural TTS — has official Mongolian voices (mn-MN-YesuiNeural, mn-MN-BataaNeural)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_TTS_VOICE_MN=mn-MN-YesuiNeural
# AZURE_TTS_VOICE_EN=en-US-JennyNeural
# ElevenLabs — needs one voice ID per language (uses ELEVENLABS_API_KEY above)
ELEVENLABS_VOICE_ID_MN=
ELEVENLABS_VOICE_ID_EN=
# ELEVENLABS_TTS_MODEL=eleven_v3
# OpenAI TTS (auto-selected for English only; uses OPENAI_API_KEY above)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# LEARN_TTS_TIMEOUT_MS=20000

# ---------- Abuse protection (optional) ----------
# Requests per minute per IP
# LEARN_CHAT_PER_MIN=20
# LEARN_STT_PER_MIN=15
# LEARN_TTS_PER_MIN=30
# Extra origins allowed to call /api/learn/* (same host is always allowed)
# LEARN_ALLOWED_ORIGINS=https://amjuulya.mn,https://www.amjuulya.mn
# Upstash Redis makes rate limits + duplicate-request checks shared across serverless instances
# (also used by the Messenger bot)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Existing Messenger bot (api/webhook.js) ----------
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# ANTHROPIC_MODEL=claude-haiku-5-5
# ADMIN_PSID=
# HUMAN_PAUSE_HOURS=6
# META_DATASET_ID=
# META_CAPI_TOKEN=
# META_CURRENCY=MNT
