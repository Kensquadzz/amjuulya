# ── Ulaan Creative — environment variables ─────────────────────────────────────
# Copy to .env.local for local development. In production set them in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Public site URL (canonical links, sitemap, Open Graph). No trailing slash.
SITE_URL=https://ulaancreative.mn
# Admin subdomain (optional). Leave empty to use https://<site>/admin instead.
ADMIN_HOST=admin.ulaancreative.mn

# PostgreSQL (Neon, Supabase, Vercel Postgres, RDS …). Use the pooled connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# DATABASE_SSL=false            # only for a local database without TLS
# DATABASE_POOL_MAX=3

# Media storage — any S3-compatible bucket (Cloudflare R2 recommended)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ulaan-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# S3_FORCE_PATH_STYLE=true      # needed for some providers (MinIO, Backblaze)
# Public base URL that serves the bucket's objects (R2 custom domain or public r2.dev URL)
MEDIA_PUBLIC_BASE_URL=https://media.ulaancreative.mn
# Upload limits in MB
MAX_IMAGE_MB=15
MAX_VIDEO_MB=500

# Admin sessions
SESSION_TTL_HOURS=12
# One-time code for creating the FIRST admin from the browser (/admin) — e.g. from a phone.
# 16+ random characters. Only works while no admin exists; remove it afterwards.
ADMIN_SETUP_TOKEN=
# Random secret used to hash visitor IPs for rate limiting (generate: openssl rand -hex 32)
IP_HASH_SALT=replace-me

# E-mail notification for every contact form / influencer inquiry (Resend, https://resend.com).
# Submissions are always stored in the database as well; e-mail is an extra copy.
# Required: RESEND_API_KEY + CONTACT_TO_EMAIL (comma-separated for several recipients).
# CONTACT_FROM_EMAIL is optional: without your own verified domain leave it empty — the shared
# sender onboarding@resend.dev is used, which delivers only to the e-mail of your Resend account.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
