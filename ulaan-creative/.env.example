# Contact form delivery (Resend — https://resend.com). Set these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
# Inbox that receives project requests (comma-separate for several)
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. Ulaan Creative <noreply@your-domain.mn>
CONTACT_FROM_EMAIL=
