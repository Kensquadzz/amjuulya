{
  "name": "motionforge-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MOTIONFORGE STUDIO \u2014 mobile-first motion design, typography animation & GLSL shader editor",
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && vite --host",
    "build": "node scripts/copy-ort.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs && node tests/app.mjs test-results && node tests/cap.mjs && node tests/cine-ui.mjs && node tests/three-ui.mjs && node tests/model.mjs",
    "icons": "node tests/icons.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "assets": "node scripts/copy-ort.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "codemirror": "^6.0.2",
    "mediabunny": "^1.61.5",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
