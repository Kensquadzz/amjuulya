{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/router.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/:path((?!api/|admin/assets/|assets/).*)", "has": [{ "type": "host", "value": "admin.ulaancreative.mn" }], "destination": "/api/router?__p=/admin/:path" },
    { "source": "/api/:path*", "destination": "/api/router?__p=/api/:path*" },
    { "source": "/admin", "destination": "/api/router?__p=/admin" },
    { "source": "/admin/:path*", "destination": "/api/router?__p=/admin/:path*" },
    { "source": "/work/:slug", "destination": "/api/router?__p=/work/:slug" },
    { "source": "/sitemap.xml", "destination": "/api/router?__p=/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/api/router?__p=/robots.txt" },
    { "source": "/", "destination": "/api/router?__p=/" },
    { "source": "/:path*", "destination": "/api/router?__p=/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/admin/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
